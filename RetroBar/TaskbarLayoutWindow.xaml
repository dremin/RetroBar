<Window x:Class="RetroBar.TaskbarLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RetroBar.Controls"
        Title="{DynamicResource taskbar_layout_title}"
        Icon="Resources/retrobar.ico"
        Width="Auto"
        Height="Auto"
        MinWidth="300"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource flow_direction}"
        Style="{DynamicResource PropertiesWindow}"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="HorizontalAlignment"
                        Value="Right" />
                <Setter Property="IsEditable"
                        Value="False" />
                <Setter Property="Margin"
                        Value="5,5,0,5" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="MinHeight"
                        Value="21" />
                <Setter Property="Width"
                        Value="150" />
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Padding"
                        Value="0" />
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Style.Resources>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Padding"
                                Value="1,2,0,0" />
                    </Style>
                </Style.Resources>
                <Setter Property="Margin"
                        Value="0,5,5,5" />
                <Setter Property="Padding"
                        Value="0" />
            </Style>
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Padding"
                        Value="5,5,5,0" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="MinHeight"
                        Value="21" />
                <Setter Property="MinWidth"
                        Value="73" />
                <Setter Property="Padding"
                        Value="10,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Same side margins as the content of the group box below -->
        <DockPanel Grid.Row="0"
                   Margin="7,0,7,0"
                   x:Name="MonitorPanel">
            <Label VerticalAlignment="Center"
                   Target="{Binding ElementName=cboMonitor}">
                <AccessText Text="{DynamicResource taskbar_layout_monitor}" />
            </Label>
            <ComboBox x:Name="cboMonitor"
                      Width="200"
                      SelectionChanged="CboMonitor_SelectionChanged" />
        </DockPanel>
        <DockPanel Grid.Row="1"
                   Margin="7,0,7,0"
                   x:Name="RowsPanel">
            <Label VerticalAlignment="Center"
                   Target="{Binding ElementName=spnRowCount}">
                <AccessText Text="{DynamicResource rowcount_text}"
                            ToolTip="{DynamicResource rowcount_tip}" />
            </Label>
            <controls:NumericSpinner x:Name="spnRowCount"
                                     HorizontalAlignment="Right"
                                     Width="50"
                                     Height="21"
                                     Margin="5,5,0,5"
                                     Minimum="1"
                                     ValueChangedByUser="SpnRowCount_ValueChangedByUser" />
        </DockPanel>
        <GroupBox Grid.Row="2"
                  Header="{DynamicResource taskbar_layout_items}">
            <StackPanel Orientation="Vertical">
                <CheckBox x:Name="cbShowStartButton"
                          Click="CheckBox_Click">
                    <Label Content="{DynamicResource show_start_button}" />
                </CheckBox>
                <CheckBox x:Name="cbShowStartButtonMultiMon"
                          Margin="16,0,5,5"
                          Click="CheckBox_Click">
                    <Label Content="{DynamicResource show_start_button_multi_mon}" />
                </CheckBox>
                <CheckBox x:Name="cbShowQuickLaunch"
                          Click="CheckBox_Click">
                    <Label Content="{DynamicResource show_quick_launch}" />
                </CheckBox>
                <CheckBox x:Name="cbShowNotifyIcons"
                          Click="CheckBox_Click">
                    <Label Content="{DynamicResource show_notify_icons}" />
                </CheckBox>
                <CheckBox x:Name="cbShowClock"
                          Click="CheckBox_Click">
                    <Label Content="{DynamicResource show_clock}" />
                </CheckBox>
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,7,0,0">
            <Button Content="{DynamicResource ok_dialog}"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OK_OnClick" />
        </StackPanel>
    </Grid>
</Window>
