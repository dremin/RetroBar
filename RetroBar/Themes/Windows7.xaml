        <GradientStop Color="#A8E3F7FF"
                      Offset="0.3" />
        <GradientStop Color="#50CFF3FF"
                      Offset="0.65" />
        <GradientStop Color="#00CFF3FF"
                      Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonBackgroundActiveHover"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#5A1C2E44"
                      Offset="0.0" />
        <GradientStop Color="#E21B3A56"
                      Offset="0.45" />
        <GradientStop Color="#F01F4062"
                      Offset="0.52" />
        <GradientStop Color="#D8296490"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonBottomHighlightActive"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Color="#00FFFFFF"
                      Offset="0.0" />
        <GradientStop Color="#D0F5FCFF"
                      Offset="0.15" />
        <GradientStop Color="#FFFFFFFF"
                      Offset="0.5" />
        <GradientStop Color="#D0F5FCFF"
                      Offset="0.85" />
        <GradientStop Color="#00FFFFFF"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonBottomHighlightActiveHover"
