        + all'inizio del file:
        using Tray = ManagedShell.WindowsTray;

        // inside void IDropTarget.Drop(IDropInfo dropInfo):
        DropInFlight = dropInfo;

        bool fromOverflow = GetContext(dropInfo.DragInfo?.VisualSource) == "NotifyIconOverflow";
        bool intoOverflow = GetContext(dropInfo.VisualTarget) == "NotifyIconOverflow";

        if (dropInfo.Data is Tray.NotifyIcon icon && fromOverflow != intoOverflow)
        {
            // cross drop tray <-> overflow = pin/unpin (IsPinned)
            icon.IsPinned = !intoOverflow;
        }
        else if (!intoOverflow)
        {
            GongSolutions.Wpf.DragDrop.DragDrop.DefaultDropHandler.Drop(dropInfo);
            _notifyIconList.UpdateIconOrder(dropInfo);
        }

        DropInFlight = null;
        }

        // helper (new private method in the class):
        private static string GetContext(System.Windows.DependencyObject d)
        {
            while (d != null)
            {
                var ctx = GongSolutions.Wpf.DragDrop.DragDrop.GetDragDropContext(d);
                if (!string.IsNullOrEmpty(ctx)) return ctx;
                d = System.Windows.Media.VisualTreeHelper.GetParent(d);
            }
            return null;
        }

