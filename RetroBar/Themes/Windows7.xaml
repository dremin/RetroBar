    <!-- Pressed: darker, tighter glass -->
    <LinearGradientBrush x:Key="TaskButtonBackgroundPressed"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#2A0C1520"
                      Offset="0.0" />
        <GradientStop Color="#96101E32"
                      Offset="1.0" />
    </LinearGradientBrush>

