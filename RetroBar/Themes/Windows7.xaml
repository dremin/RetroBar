<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:RetroBar.Controls;assembly=RetroBar"
                    xmlns:retroconv="clr-namespace:RetroBar.Converters;assembly=RetroBar"
                    xmlns:retrosettings="clr-namespace:RetroBar.Utilities;assembly=RetroBar">

    <!-- Win7 Superbar height at 96 DPI -->

    <!-- ===== Windhawk Win7 overflow resources: PNGs from the Resources folder =====
         The three chevron images (9x7 arrow + 21x20 glass tiles) are files
         in the ../Resources folder next to Themes (same mechanism as the
         stock RetroBar theme Start icons). -->
    <BitmapImage x:Key="OverflowArrowImage"
                 UriSource="../Resources/Win7_Overflow_Arrow.png" />
    <BitmapImage x:Key="OverflowTileHoverImage"
                 UriSource="../Resources/Win7_Overflow_TileHover.png" />
    <BitmapImage x:Key="OverflowTilePressedImage"
                 UriSource="../Resources/Win7_Overflow_TilePressed.png" />

    <!-- TASKBAR BACKGROUND PNG - texture on top of transparency -->
    <BitmapImage x:Key="TaskbarBackgroundImage"
                 UriSource="../Resources/taskbarBackground.png" />
    <ImageBrush x:Key="TaskbarTextureBrush"
                ImageSource="{DynamicResource TaskbarBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,1,40"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1" />
    <ImageBrush x:Key="Win7_TaskbarTextureBrushVertical"
                ImageSource="{DynamicResource TaskbarBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,60,1"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1" />
    <BitmapImage x:Key="Win7_ShowDesktopImage" UriSource="../Resources/win7showdesktop.png" />
    <BitmapImage x:Key="Win7_ShowDesktopImageScaled" UriSource="../Resources/win7showdesktop.png" />
    <BitmapImage x:Key="Win7_TaskbarTextureImage" UriSource="../Resources/win7taskbar.png" />
    <ImageBrush x:Key="Win7_TaskbarTextureBrush"
                ImageSource="{StaticResource Win7_TaskbarTextureImage}"
                TileMode="Tile"
                Viewport="0,0,600,40"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1" />
    <ImageBrush x:Key="Win7_Win7_TaskbarTextureBrushVertical"
                ImageSource="{StaticResource Win7_TaskbarTextureImage}"
                TileMode="Tile"
                Viewport="0,0,40,600"
                ViewportUnits="Absolute"
                Stretch="Fill"
                Opacity="1">
        <ImageBrush.Transform>
            <RotateTransform Angle="90" />
        </ImageBrush.Transform>
    </ImageBrush>



    <!-- ===== WIN7 THEME RESOURCES FROM https://github.com/ramensoftware/windows-11-taskbar-styling-guide/tree/main/Themes/Windows7/ThemeResources =====
         All resources implemented, excluding those already present (unmodified) -->
    <BitmapImage x:Key="Win7_ActiveNormalImage" UriSource="../Resources/Win7/ActiveNormal.png" />
    <BitmapImage x:Key="Win7_InactiveNormalImage" UriSource="../Resources/Win7/InactiveNormal.png" />
    <BitmapImage x:Key="Win7_InactivePointerOverImage" UriSource="../Resources/Win7/InactivePointerOver.png" />
    <BitmapImage x:Key="Win7_NotRunningPointerOverImage" UriSource="../Resources/Win7/notRunningPointerOver.png" />
    <BitmapImage x:Key="Win7_NotRunningPressedImage" UriSource="../Resources/Win7/notRunningPressed.png" />
    <BitmapImage x:Key="Win7_RequestingAttentionImage" UriSource="../Resources/Win7/requestingAttention.png" />
    <BitmapImage x:Key="Win7_DesktopNormalImage" UriSource="../Resources/Win7/desktopNormal.png" />
    <BitmapImage x:Key="Win7_DesktopPointerOverImage" UriSource="../Resources/Win7/desktopPointerOver.png" />
    <BitmapImage x:Key="Win7_DesktopPressedImage" UriSource="../Resources/Win7/desktopPressed.png" />
    <BitmapImage x:Key="Win7_SearchImage" UriSource="../Resources/Win7/search.png" />
    <BitmapImage x:Key="Win7_TaskViewImage" UriSource="../Resources/Win7/taskview.png" />
    <BitmapImage x:Key="Win7_WidgetsPointerOverImage" UriSource="../Resources/Win7/widgetsPointerOver.png" />
    <BitmapImage x:Key="Win7_WidgetsPressedImage" UriSource="../Resources/Win7/widgetsPressed.png" />
    <BitmapImage x:Key="Win7_AeroPeekImage" UriSource="../Resources/Win7/AeroPeek.png" />
    <BitmapImage x:Key="Win7_AeroPeekBlueImage" UriSource="../Resources/Win7/AeroPeekBlue.png" />
    <BitmapImage x:Key="Win7_OverflowNormalImage" UriSource="../Resources/Win7/overflowNormal.png" />
    <BitmapImage x:Key="Win7_OverflowPointerOverImage" UriSource="../Resources/Win7/overflowPointerOver.png" />
    <BitmapImage x:Key="Win7_OverflowPressedImage" UriSource="../Resources/Win7/overflowPressed.png" />
    <BitmapImage x:Key="Win7_TrayPointerOverImage" UriSource="../Resources/Win7/trayPointerOver.png" />
    <BitmapImage x:Key="Win7_TrayPressedImage" UriSource="../Resources/Win7/trayPressed.png" />
    <BitmapImage x:Key="Win7_ClockPointerOverImage" UriSource="../Resources/Win7/clockPointerOver.png" />
    <BitmapImage x:Key="Win7_ClockPressedImage" UriSource="../Resources/Win7/clockPressed.png" />
    <BitmapImage x:Key="Win7_OrbNormalImage" UriSource="../Resources/Win7/orbNormal.png" />
    <BitmapImage x:Key="Win7_OrbHoverImage" UriSource="../Resources/Win7/orbHover.png" />
    <BitmapImage x:Key="Win7_OrbPressedImage" UriSource="../Resources/Win7/orbPressed.png" />

    <ImageBrush x:Key="Win7_ActiveNormalBrush" ImageSource="{StaticResource Win7_ActiveNormalImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_InactiveNormalBrush" ImageSource="{StaticResource Win7_InactiveNormalImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_InactivePointerOverBrush" ImageSource="{StaticResource Win7_InactivePointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_NotRunningPointerOverBrush" ImageSource="{StaticResource Win7_NotRunningPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_NotRunningPressedBrush" ImageSource="{StaticResource Win7_NotRunningPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_RequestingAttentionBrush" ImageSource="{StaticResource Win7_RequestingAttentionImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_DesktopNormalBrush" ImageSource="{StaticResource Win7_DesktopNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_DesktopPointerOverBrush" ImageSource="{StaticResource Win7_DesktopPointerOverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_DesktopPressedBrush" ImageSource="{StaticResource Win7_DesktopPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowNormalBrush" ImageSource="{StaticResource Win7_OverflowNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowPointerOverBrush" ImageSource="{StaticResource Win7_OverflowPointerOverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OverflowPressedBrush" ImageSource="{StaticResource Win7_OverflowPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_TrayPointerOverBrush" ImageSource="{StaticResource Win7_TrayPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_TrayPressedBrush" ImageSource="{StaticResource Win7_TrayPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_ClockPointerOverBrush" ImageSource="{StaticResource Win7_ClockPointerOverImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_ClockPressedBrush" ImageSource="{StaticResource Win7_ClockPressedImage}" Stretch="Fill" />
    <ImageBrush x:Key="Win7_OrbNormalBrush" ImageSource="{StaticResource Win7_OrbNormalImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OrbHoverBrush" ImageSource="{StaticResource Win7_OrbHoverImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_OrbPressedBrush" ImageSource="{StaticResource Win7_OrbPressedImage}" Stretch="None" />
    <ImageBrush x:Key="Win7_AeroPeekBrush" ImageSource="{StaticResource Win7_AeroPeekImage}" Stretch="Fill" Opacity="0.9" />
    <ImageBrush x:Key="Win7_AeroPeekBlueBrush" ImageSource="{StaticResource Win7_AeroPeekBlueImage}" Stretch="Fill" Opacity="0.9" />


    <!-- Win7 TRAY/CLOCK real hover (PNG from the Windhawk Win7 skin in
         ../Resources): NOT rectangles — just the two vertical "whiskers" of
         light on the sides | icon | with a glow at the bottom. Rest: INVISIBLE. -->
    <BitmapImage x:Key="TrayTileHoverImage"
                 UriSource="../Resources/Win7_Tray_TileHover.png" />
    <BitmapImage x:Key="TrayTilePressedImage"
                 UriSource="../Resources/Win7_Tray_TilePressed.png" />
    <BitmapImage x:Key="ClockTileHoverImage"
                 UriSource="../Resources/Win7_Clock_TileHover.png" />
    <BitmapImage x:Key="ClockTilePressedImage"
                 UriSource="../Resources/Win7_Clock_TilePressed.png" />

    <system:Double x:Key="TaskbarHeight">40</system:Double>
    <system:Double x:Key="TaskbarRowHeight">34</system:Double>
    <system:Double x:Key="TaskbarWidth">60</system:Double>
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <system:Boolean x:Key="UseFloatingStartButton">True</system:Boolean>
    <system:Boolean x:Key="UseLargeIcons">True</system:Boolean>
    <!-- Combine-like horizontal buttons (icon-only, as in the vertical layout):
         58px like the Win7 Superbar button = 32px icon + 13px glass per side -->
    <system:Double x:Key="TaskButtonWidth">58</system:Double>
    <system:Double x:Key="TaskButtonMinWidth">50</system:Double>
    <!-- 1px vertical gap so the 40px glass buttons breathe inside the 40px bar -->
    <Thickness x:Key="TaskButtonMargin" Left="1" Top="1" Right="1" Bottom="1" />
    <FontWeight x:Key="SetTimeMenuItemWeight">Normal</FontWeight>
    <!-- Windows 7 Aero glass: black glass tint with the subtle top reflection
         band, over DWM blur (AllowBlurBehind) or straight transparency. -->
    <!-- OpenGlass-style: lighter tint, more desktop showing through transparency -->
    <!-- VERY SOFT TRANSPARENCY: desktop almost clean -->
        <!-- ULTRA-ACCENTUATED TRANSPARENCY - ALMOST SEE THE DESKTOP LIKE THE WIN7 PHOTO
         Win7 photo: Aero glass with blur, blue wallpaper peeking through
         In RetroBar: very-white 3-8% gradient + 3% texture -->
    <LinearGradientBrush x:Key="TaskbarBackground"
                         MappingMode="Absolute"
                         StartPoint="0,0"
                         EndPoint="0,40">
        <GradientStop Color="#0AFFFFFF" Offset="0.0" />
        <GradientStop Color="#05FFFFFF" Offset="0.08" />
        <GradientStop Color="#02000000" Offset="0.5" />
        <GradientStop Color="#04000000" Offset="1.0" />
    </LinearGradientBrush>
        <LinearGradientBrush x:Key="TaskbarVerticalBackground"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Color="#0AFFFFFF" Offset="0.0" />
        <GradientStop Color="#05FFFFFF" Offset="0.25" />
        <GradientStop Color="#02000000" Offset="0.25" />
        <GradientStop Color="#04000000" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TaskbarWindowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarTopBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarTopInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarBottomInnerBorder" Color="Transparent" />
    <!-- Fully transparent pixels (alpha 0) are not hit-testable in an
         AllowsTransparency window, so the last pixel row dropped clicks onto
         the desktop (opening the desktop context menu). Alpha 1 is invisible
         but still catches clicks right up to the screen edge. -->
    <SolidColorBrush x:Key="TaskbarBottomBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalTopBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalTopInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TaskbarVerticalBottomInnerBorder" Color="Transparent" />
    <!-- Same pass-through fix for the screen-edge column of a vertical taskbar -->
    <SolidColorBrush x:Key="TaskbarVerticalBottomBorder" Color="Transparent" />

    <SolidColorBrush x:Key="TrayToggleOuterBorder" Color="#20ffffff" />
    <!-- resolves a reference inherited from the Vista base theme; Transparent
         keeps the tray toggle visually identical to Vista -->
    <SolidColorBrush x:Key="TrayToggleBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TrayToggleBorder" Color="#99000000" />
    <LinearGradientBrush x:Key="TrayToggleHoverBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#6d758b"
                      Offset="0.0" />
        <GradientStop Color="#3a4975"
                      Offset="0.5" />
        <GradientStop Color="#060e3e"
                      Offset="0.5" />
        <GradientStop Color="#212e7a"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TrayTogglePressedBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#0d0e11"
                      Offset="0.0" />
        <GradientStop Color="#273255"
                      Offset="0.5" />
        <GradientStop Color="#070e35"
                      Offset="0.5" />
        <GradientStop Color="#202c70"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TrayToggleArrowForeground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#e4e6ec"
                      Offset="0.0" />
        <GradientStop Color="#d9dce5"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TrayToggleArrowPressed"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#dadbdd"
                      Offset="0.0" />
        <GradientStop Color="#d9dbe4"
                      Offset="1.0" />
    </LinearGradientBrush>
    <Thickness x:Key="TrayToggleArrowPadding" Left="4" Top="4" Right="5" Bottom="4" />

    <!-- ================= Windows 7 Superbar button brushes ================= -->
    <!-- Normal: barely-there glass outline, always visible on the bar -->
    <!-- Normal state: subtle glass outline (values from the reference Win7 theme) -->
    <SolidColorBrush x:Key="TaskButtonOuterBorder" Color="#44000000" />
    <SolidColorBrush x:Key="TaskButtonInnerBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorder" Color="#14ffffff" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorder" Color="#14ffffff" />
    <LinearGradientBrush x:Key="TaskButtonBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#2Effffff"
                      Offset="0.0" />
        <GradientStop Color="#14ffffff"
                      Offset="0.5" />
        <GradientStop Color="Transparent"
                      Offset="0.5" />
    </LinearGradientBrush>

    <!-- ===== SUPERBAR PINNED LOGIC: pinned icons transparent at rest ===== -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerTopRightBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomLeftBorderPinned" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundPinned" Color="Transparent" />


    <!-- Hover: bright Aero glass highlight with soft base glow -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderHover" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderHover" Color="#54FFFFFF" />
    <LinearGradientBrush x:Key="TaskButtonInnerTopRightBorderHover"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF"
                      Offset="0.0" />
        <GradientStop Color="#66FFFFFF"
                      Offset="0.4" />
        <GradientStop Color="#00FFFFFF"
                      Offset="0.6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonInnerBottomLeftBorderHover"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#00FFFFFF"
                      Offset="0.5" />
        <GradientStop Color="#59FFFFFF"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonBackgroundHover"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#8CFFFFFF"
                      Offset="0.0" />
        <GradientStop Color="#3EFFFFFF"
                      Offset="0.42" />
        <GradientStop Color="#2BFFFFFF"
                      Offset="0.5" />
        <GradientStop Color="#31FFFFFF"
                      Offset="0.56" />
        <GradientStop Color="#5FFFFFFF"
                      Offset="1.0" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="TaskButtonBottomBackgroundHover"
                         GradientOrigin="0.5,1.0"
                         Center="0.5,1.0"
                         RadiusX="0.75"
                         RadiusY="0.6">
        <GradientStop Color="#66D6F0FF"
                      Offset="0.0" />
        <GradientStop Color="#00D6F0FF"
                      Offset="0.7" />
    </RadialGradientBrush>

    <!-- Active: dark glass "open window" button with lit base -->
    <SolidColorBrush x:Key="TaskButtonOuterBorderActive" Color="#FF4A7FDA" />
    <SolidColorBrush x:Key="TaskButtonInnerBorderActive" Color="#E02A5AE0" />
    <LinearGradientBrush x:Key="TaskButtonInnerTopRightBorderActive"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF"
                      Offset="0.0" />
        <GradientStop Color="#3EFFFFFF"
                      Offset="0.35" />
        <GradientStop Color="#00FFFFFF"
                      Offset="0.55" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonInnerBottomLeftBorderActive"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#00FFFFFF"
                      Offset="0.6" />
        <GradientStop Color="#66FFFFFF"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskButtonBackgroundActive"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#66121C2A"
                      Offset="0.0" />
        <GradientStop Color="#E80D1826"
                      Offset="0.45" />
        <GradientStop Color="#F00C1522"
                      Offset="0.52" />
        <GradientStop Color="#E8234A6E"
                      Offset="1.0" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="TaskButtonBottomBackgroundActive"
                         GradientOrigin="0.5,1.0"
                         Center="0.5,1.0"
                         RadiusX="0.75"
                         RadiusY="0.35">
        <GradientStop Color="#E8FAFEFF"
                      Offset="0.0" />
        <GradientStop Color="#A0D9F2FF"
                      Offset="0.3" />
        <GradientStop Color="#50BFE9FF"
                      Offset="0.65" />
        <GradientStop Color="#00BFE3FF"
                      Offset="1.0" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="TaskButtonBottomBackgroundActiveHover"
