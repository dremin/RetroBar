    <Style TargetType="ToolTip"
           x:Key="{x:Type ToolTip}"
           BasedOn="{StaticResource GlobalFonts}">
        <!-- Same tooltip as the Windows Vista Aero XAML: light gradient, single
             1px border, 2px corner radius -->
        <Setter Property="Background"
                Value="{DynamicResource VistaToolTipBackground}" />
        <Setter Property="Foreground"
                Value="{DynamicResource VistaToolTipForeground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource VistaToolTipBorder}" />
        <Setter Property="Padding"
                Value="5,2,5,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <ContentPresenter />
                    </Border>
