      PATCH 1+3 - RetroBar/Controls/NotifyIconList.xaml.cs

        // in the constructor, after InitializeComponent();
        dropHandler = new NotifyIconDropHandler(this);

        // new public member (NotifyIconList class):
        public NotifyIconDropHandler DropHandler => dropHandler;

        public override void OnApplyTemplate()
        {
            base.OnApplyTemplate();

            // guarded lookups: the names come from THIS theme's template;
            // behavior stays unchanged for all other themes

            if (GetTemplateChild("OverflowIcons") is ItemsControl overflowItems)
            {
                GongSolutions.Wpf.DragDrop.DragDrop.SetDropHandler(overflowItems, DropHandler);
                GongSolutions.Wpf.DragDrop.DragDrop.SetIsDragSource(overflowItems, true);
                GongSolutions.Wpf.DragDrop.DragDrop.SetIsDropTarget(overflowItems, true);
                GongSolutions.Wpf.DragDrop.DragDrop.SetDragDropContext(overflowItems, "NotifyIconOverflow");
            }

            if (GetTemplateChild("CustomizeLink") is FrameworkElement customize)
            {
                customize.PreviewMouseLeftButtonUp += CustomizeLink_OnClick;
            }

            if (GetTemplateChild("OverflowPopup") is System.Windows.Controls.Primitives.Popup glassPopup)
            {
                glassPopup.Opened += OverflowPopup_Opened;
            }
        }

        private void CustomizeLink_OnClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = "shell:::{05d7B0F4-2121-4eff-BF6B-ED3F69B894D9}",
                UseShellExecute = true
            });

            if (GetTemplateChild("OverflowPopup") is System.Windows.Controls.Primitives.Popup popup)
            {
                popup.IsOpen = false;
            }

            e.Handled = true;
        }

        // PATCH 3 - native DWM glass on the overflow (blur + OS rounded corners)
        private void OverflowPopup_Opened(object sender, EventArgs e)
        {
            var popup = (System.Windows.Controls.Primitives.Popup)sender;
            if (popup.Child == null) return;
            if (!(PresentationSource.FromVisual(popup.Child) is System.Windows.Interop.HwndSource hwndSource)) return;

            IntPtr hWnd = hwndSource.Handle;
            var blurBehind = new DwmBlurBehind { DwFlags = 1 /* DWM_BB_ENABLE */, Enable = true };
            DwmEnableBlurBehindWindow(hWnd, ref blurBehind);

            int roundCorners = 2; // DWMWCP_ROUND, ignored where unsupported
            DwmSetWindowAttribute(hWnd, 33 /* DWMWA_WINDOW_CORNER_PREFERENCE */, ref roundCorners, 4);
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct DwmBlurBehind
        {
            public uint DwFlags;
            public bool Enable;
            public IntPtr BlurRegion;
            public bool TransitionOnMaximized;
        }

        [DllImport("dwmapi.dll", PreserveSig = true)]
        private static extern int DwmEnableBlurBehindWindow(IntPtr hWnd, ref DwmBlurBehind blurBehind);

        [DllImport("dwmapi.dll", PreserveSig = true)]
        private static extern int DwmSetWindowAttribute(IntPtr hWnd, int attribute, ref int value, int valueSize);

