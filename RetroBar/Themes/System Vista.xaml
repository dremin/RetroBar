<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="System XP.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Overrides the base fallback of 3 (System.xaml) - Vista shipped Quick Launch with
         only 2 icons pinned by default. -->
    <system:Int32 x:Key="QuickLaunchDefaultVisibleItems">2</system:Int32>

    <BitmapImage x:Key="StartIconImage"
                 UriSource="../Resources/startvistaclassic.png" />

    <ToolTip x:Key="StartButtonTip"
             Content="{DynamicResource start_button_tip_vista}" />

    <Style TargetType="Image"
           x:Key="StartIcon"
           BasedOn="{StaticResource StartIcon}">
        <Setter Property="Margin"
                Value="-2,0,1,0" />
    </Style>

    <Style TargetType="TextBlock"
           x:Key="StartLabel"
           BasedOn="{StaticResource StartLabel}">
        <Setter Property="Margin"
                Value="0,0,0,1" />
    </Style>
</ResourceDictionary>