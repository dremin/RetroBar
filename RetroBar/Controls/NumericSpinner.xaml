<UserControl x:Class="RetroBar.Controls.NumericSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="ValueTextBox"
                 Grid.RowSpan="2"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Right"
                 Padding="2,0"
                 PreviewTextInput="ValueTextBox_PreviewTextInput"
                 TextChanged="ValueTextBox_TextChanged"
                 PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                 MouseWheel="ValueTextBox_MouseWheel"
                 LostFocus="ValueTextBox_LostFocus" />
        <RepeatButton x:Name="UpButton"
                      Grid.Column="1"
                      Grid.Row="0"
                      Width="16"
                      Padding="0"
                      Focusable="False"
                      Click="UpButton_Click">
            <Path Data="M 0 4 L 3.5 0 L 7 4 Z"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
        </RepeatButton>
        <RepeatButton x:Name="DownButton"
                      Grid.Column="1"
                      Grid.Row="1"
                      Width="16"
                      Padding="0"
                      Focusable="False"
                      Click="DownButton_Click">
            <Path Data="M 0 0 L 7 0 L 3.5 4 Z"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
        </RepeatButton>
    </Grid>
</UserControl>
