<Window x:Class="RetroBar.Controls.FloatingStartButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utilities="clr-namespace:RetroBar.Utilities"
        Title=""
        Style="{DynamicResource FloatingStartButtonWindow}"
        SourceInitialized="Window_SourceInitialized"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        FlowDirection="{DynamicResource flow_direction}">
    <ToggleButton Name="Start"
                  ToolTip="{DynamicResource StartButtonTip}"
                  Click="Start_OnClick"
                  DragEnter="Start_DragEnter"
                  DragLeave="Start_DragLeave"
                  PreviewMouseLeftButtonDown="Start_OnPreviewMouseLeftButtonDown"
                  MouseRightButtonUp="Start_OnMouseRightButtonUp"
                  Style="{DynamicResource StartButton}"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  RenderOptions.EdgeMode="Unspecified"
                  Margin="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
        <ToggleButton.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Source={x:Static utilities:Settings.Instance}, Path=TaskbarScale}"
                            ScaleY="{Binding Source={x:Static utilities:Settings.Instance}, Path=TaskbarScale}"
                            CenterX="0"
                            CenterY="0" />
        </ToggleButton.LayoutTransform>
        <ToggleButton.RenderTransform>
            <TranslateTransform X="{Binding Path=Host.AutoHideElement.RenderTransform.(TranslateTransform.X)}"
                                Y="{Binding Path=Host.AutoHideElement.RenderTransform.(TranslateTransform.Y)}" />
        </ToggleButton.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Style="{DynamicResource StartIcon}" />
        </Grid>
    </ToggleButton>
</Window>
